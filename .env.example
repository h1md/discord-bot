# Token du bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID du serveur de test (clic droit sur le serveur > Copier l'identifiant).
# Utilisé pour deployer les commandes instantanement sur un seul serveur.
# Laisse vide et utilise `npm run deploy:global` pour un deploiement global (plus lent a propager).
GUILD_ID=

# IDs des proprietaires du bot (separes par des virgules) pour les commandes "Owner Bot"
OWNER_IDS=

# Prefixe par defaut des commandes texte (ex: +ban @membre). Modifiable par serveur avec /prefix-set
DEFAULT_PREFIX=+
